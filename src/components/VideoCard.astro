---
interface Props {
  title: string;
  description?: string;
  thumbnail: string;
  slug: string;
  category?: string;
}

const {
  title,
  description,
  thumbnail,
  slug,
  category = "Finance",
} = Astro.props;

const href = `/videos/${slug}`;
---

<article class="video-card">
  <a href={href} class="thumbnail" aria-label={`Watch ${title}`}>
    <img src={thumbnail} alt={title} loading="lazy" />

    <span class="play" aria-hidden="true">▶</span>
  </a>

  <div class="content">
    <span class="category">{category}</span>

    <h3>
      <a href={href}>{title}</a>
    </h3>

    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .video-card {
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: white;
  }

  .thumbnail {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e5e7eb;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: white;
    color: #111827;
    font-size: 18px;
  }

  .content {
    padding: 20px;
  }

  .category {
    font-size: 0.8rem;
    color: #6b7280;
  }

  h3 {
    margin: 8px 0;
  }

  h3 a {
    color: #111827;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    color: #6b7280;
    line-height: 1.6;
  }
</style>