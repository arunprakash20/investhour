---
---

<header class="site-header">
  <div class="header-container">
    <a
      href="/"
      class="brand"
      aria-label="INVESThOuR home"
    >
      <img
        src="/images/investhour-logo.png"
        alt="INVESThOuR"
      />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/videos">Videos</a>
        <a href="/blog">Articles</a>
        <a href="/tools">Tools</a>
        <a href="/about">About</a>
    </nav>

    <div class="header-actions">
      <a
        href="https://www.youtube.com/@INVESThOuR"
        target="_blank"
        rel="noopener noreferrer"
        class="youtube-link"
        aria-label="INVESThOuR on YouTube"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.9V8.1l6.7 3.9-6.7 3.9Z"
          />
        </svg>
      </a>

      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
      >
        <span class="theme-icon">◐</span>
      </button>

      <button
        class="menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav>
        <a href="/">Home</a>
        <a href="/videos">Videos</a>
        <a href="/blog">Articles</a>
        <a href="/tools">Tools</a>
        <a href="/about">About</a>
    </nav>

    <a
      href="https://www.youtube.com/@INVESThOuR"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-youtube"
    >
      Watch on YouTube →
    </a>
  </div>
</header>

<script>
  const STORAGE_KEY = "investhour-theme";

  function applyTheme(theme) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem(STORAGE_KEY, theme);
  }

  function getTheme() {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (saved === "light" || saved === "dark") {
      return saved;
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function initialiseTheme() {
    applyTheme(getTheme());

    const themeToggle =
      document.querySelector(".theme-toggle");

    if (!themeToggle || themeToggle.dataset.bound === "true") {
      return;
    }

    themeToggle.dataset.bound = "true";

    themeToggle.addEventListener("click", () => {
      const current =
        document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "light";

      applyTheme(current === "dark" ? "light" : "dark");
    });
  }

  function initialiseMenu() {
    const menuButton =
      document.querySelector(".menu-button");

    const mobileMenu =
      document.querySelector(".mobile-menu");

    if (
      !menuButton ||
      !mobileMenu ||
      menuButton.dataset.bound === "true"
    ) {
      return;
    }

    menuButton.dataset.bound = "true";

    menuButton.addEventListener("click", () => {
      const open =
        mobileMenu.classList.toggle("open");

      menuButton.setAttribute(
        "aria-expanded",
        String(open)
      );

      menuButton.classList.toggle(
        "active",
        open
      );
    });

    mobileMenu
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.remove("open");
          menuButton.classList.remove("active");
          menuButton.setAttribute(
            "aria-expanded",
            "false"
          );
        });
      });
  }

  function initialiseHeader() {
    initialiseTheme();
    initialiseMenu();
  }

  document.addEventListener(
    "astro:page-load",
    initialiseHeader
  );

  initialiseHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: color-mix(
      in srgb,
      var(--bg) 90%,
      transparent
    );
    backdrop-filter: blur(18px);
  }

  .header-container {
    width: min(var(--container), calc(100% - 40px));
    min-height: 82px;
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

    .brand {
        display: flex;
        align-items: center;
        width: 160px;
    }

    .brand img {
        display: block;
        width: 100%;
        height: auto;
    }

    html[data-theme="dark"] .brand img {
        filter: invert(1) hue-rotate(180deg);
    }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .desktop-nav a {
    position: relative;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--brand);
    transition: width 180ms ease;
  }

  .desktop-nav a:hover {
    color: var(--text);
  }

  .desktop-nav a:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .youtube-link,
  .theme-toggle,
  .menu-button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
  }

  .youtube-link {
    color: #ff0000;
    text-decoration: none;
    transition:
      width 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .youtube-link svg {
    width: 20px;
    height: 20px;
  }

  .youtube-link:hover {
    width: 92px;
    color: white;
    background: #ff0000;
  }

  .theme-toggle {
    cursor: pointer;
    font-size: 1.05rem;
  }

  .theme-toggle:hover {
    background: var(--surface-soft);
  }

  .menu-button {
    display: none;
    cursor: pointer;
  }

  .menu-button span {
    width: 18px;
    height: 2px;
    margin: 2px 0;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .menu-button.active span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-button.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-button.active span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    padding: 0 20px 20px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu nav a {
    padding: 17px 0;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-youtube {
    display: block;
    margin-top: 18px;
    padding: 14px;
    border-radius: 12px;
    background: #ff0000;
    color: white;
    text-align: center;
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-menu.open {
    display: block;
  }

  @media (max-width: 800px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .brand {
      width: 140px;
    }
  }
</style>