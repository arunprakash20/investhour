---
interface Props {
  title: string;
  description?: string;
  date: string;
  category: string;
  href: string;
}

const { title, description, date, category, href } = Astro.props;
---

<article class="article-card">
  <span class="category">{category}</span>

  <h3>
    <a href={href}>{title}</a>
  </h3>

  {description && <p>{description}</p>}

  <time>{date}</time>

  <a href={href} class="read-more">Read article →</a>
</article>

<style>
  .article-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .category {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  h3 {
    margin: 12px 0 8px;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  time {
    display: block;
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .read-more {
    display: inline-block;
    margin-top: 18px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
</style>