---
import Layout from "../../layouts/Layout.astro";

const tools = [
  {
    number: "01",
    title: "Rent vs Buy Calculator",
    description:
      "Compare rent, EMI, maintenance, opportunity cost and investment growth before deciding whether buying actually makes sense.",
    category: "Personal Finance",
    status: "Coming Soon",
    featured: true,
  },
  {
    number: "02",
    title: "SIP Calculator",
    description:
      "See how regular investments could grow over time and understand the effect of contribution, time and returns.",
    category: "Investing",
    status: "Coming Soon",
    featured: false,
  },
  {
    number: "03",
    title: "EMI Calculator",
    description:
      "Understand monthly payments, total interest and the real cost of borrowing.",
    category: "Personal Finance",
    status: "Coming Soon",
    featured: false,
  },
  {
    number: "04",
    title: "IPO Decision Tool",
    description:
      "A structured way to evaluate an IPO before deciding whether it deserves your attention.",
    category: "Investing",
    status: "Planned",
    featured: false,
  },
];
---

<Layout
  title="Tools | INVESThOuR"
  description="Practical finance and investing tools from INVESThOuR."
>
  <main class="tools-page">

    <section class="tools-hero">
      <div class="container">
        <p class="eyebrow">INVESThOuR TOOLS</p>

        <h1>
          Don't just understand
          <span>the numbers.</span>
        </h1>

        <p class="hero-copy">
          Use practical calculators and decision tools to turn
          financial concepts into something you can actually apply.
        </p>
      </div>
    </section>

    <section class="tools-section">
      <div class="container">

        <div class="section-intro">
          <div>
            <p class="eyebrow">BUILDING IN PUBLIC</p>
            <h2>Useful tools, not complicated spreadsheets.</h2>
          </div>

          <p>
            We're building tools around real financial decisions —
            the questions people actually ask before spending,
            borrowing or investing money.
          </p>
        </div>

        <div class="tools-grid">
          {tools.map((tool) => (
            <article
              class:list={[
                "tool-card",
                tool.featured && "featured",
              ]}
            >
              <div class="tool-top">
                <span class="number">{tool.number}</span>

                <span class="status">
                  {tool.status}
                </span>
              </div>

              <div class="tool-body">
                <p class="category">{tool.category}</p>

                <h3>{tool.title}</h3>

                <p>{tool.description}</p>
              </div>

              <div class="tool-bottom">
                <span>
                  {tool.status === "Coming Soon"
                    ? "Coming soon"
                    : "On the roadmap"}
                </span>

                <span>→</span>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="character-section">
      <div class="container">
        <div class="character-card">

          <div class="character-copy">
            <p class="eyebrow">WHAT WE'RE TRYING TO DO</p>

            <h2>
              Less
              <span>"What does this mean?"</span>
              and more
              <span>"What should I do?"</span>
            </h2>

            <p>
              The best financial tools shouldn't just calculate a number.
              They should help you understand what that number means
              for an actual decision.
            </p>
          </div>

          <div class="character-visual" aria-hidden="true">
            <div class="speech speech-one">
              So... what does this mean?
            </div>

            <div class="coin coin-one">
              ₹
            </div>

            <div class="coin coin-two">
              %
            </div>

            <div class="scribble">
              ↗
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="tools-cta">
      <div class="container">
        <div class="cta-inner">

          <div>
            <p class="eyebrow">UNTIL THEN</p>

            <h2>
              Learn the idea
              <span>first.</span>
            </h2>

            <p>
              Explore the latest videos and articles while
              the tools are being built.
            </p>
          </div>

          <div class="actions">
            <a href="/videos" class="primary">
              Watch videos →
            </a>

            <a href="/blog" class="secondary">
              Read articles
            </a>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .tools-page {
    color: var(--text);
  }

  .container {
    width: min(var(--container), calc(100% - 40px));
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tools-hero {
    padding: 92px 0 75px;
    border-bottom: 1px solid var(--border);
  }

  .tools-hero h1 {
    max-width: 900px;
    margin: 16px 0 22px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .tools-hero h1 span {
    color: var(--brand);
  }

  .hero-copy {
    max-width: 720px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .tools-section {
    padding: 80px 0 100px;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 50px;
    align-items: end;
    margin-bottom: 40px;
  }

  .section-intro h2 {
    max-width: 700px;
    margin: 10px 0 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .section-intro > p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .tool-card {
    min-height: 330px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: var(--shadow-soft);
  }

  .tool-card.featured {
    background: var(--surface-soft);
  }

  .tool-top,
  .tool-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .number {
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .status {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .category {
    margin: 0 0 8px;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-body h3 {
    margin: 0 0 12px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .tool-body > p:last-child {
    max-width: 520px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .tool-bottom {
    margin-top: 35px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .character-section {
    padding: 0 0 100px;
  }

  .character-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    overflow: hidden;
    min-height: 410px;
    border-radius: var(--radius-lg);
    background: #121916;
    color: white;
  }

  html[data-theme="dark"] .character-card {
    background: #161c19;
  }

  .character-copy {
    padding: 55px;
    align-self: center;
  }

  .character-copy h2 {
    max-width: 700px;
    margin: 12px 0 20px;
    color: white;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .character-copy h2 span {
    color: var(--brand);
  }

  .character-copy > p:last-child {
    max-width: 570px;
    margin: 0;
    color: #b4beb9;
    line-height: 1.75;
  }

  .character-visual {
    position: relative;
    min-height: 410px;
  }

  .speech {
    position: absolute;
    top: 24%;
    right: 8%;
    max-width: 240px;
    padding: 14px 18px;
    border-radius: 16px;
    background: #f4f5f1;
    color: #121916;
    font-family: var(--font-display);
    font-size: 1.1rem;
    transform: rotate(4deg);
  }

  .coin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border: 3px solid var(--brand);
    border-radius: 50%;
    color: var(--brand);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
  }

  .coin-one {
    top: 53%;
    right: 25%;
    transform: rotate(-10deg);
  }

  .coin-two {
    right: 8%;
    bottom: 15%;
    transform: rotate(12deg);
  }

  .scribble {
    position: absolute;
    left: 15%;
    bottom: 20%;
    color: var(--brand);
    font-size: 3.5rem;
    transform: rotate(-12deg);
  }

  .tools-cta {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 85px 0;
  }

  .cta-inner h2 {
    max-width: 650px;
    margin: 10px 0 12px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .cta-inner h2 span {
    color: var(--brand);
  }

  .cta-inner p:not(.eyebrow) {
    max-width: 550px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 10px;
  }

  .primary,
  .secondary {
    padding: 13px 17px;
    border-radius: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--brand);
    color: #07100d;
  }

  .secondary {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  @media (max-width: 850px) {
    .section-intro {
      grid-template-columns: 1fr;
    }

    .character-card {
      grid-template-columns: 1fr;
    }

    .character-visual {
      min-height: 290px;
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 650px) {
    .tools-hero {
      padding: 55px 0 48px;
    }

    .tools-hero h1 {
      font-size: clamp(3.2rem, 15vw, 5rem);
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .character-copy {
      padding: 35px 25px 25px;
    }

    .actions {
      width: 100%;
      flex-direction: column;
    }

    .primary,
    .secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>