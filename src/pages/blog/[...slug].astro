---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedDate = post.data.date.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title={`${post.data.title} | INVESThOuR`}
  description={post.data.description}
>
  <main class="article-page">

    <section class="article-hero">
      <div class="container">

        <div class="breadcrumbs">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/blog">Articles</a>
          <span>/</span>
          <span>{post.data.category}</span>
        </div>

        <div class="hero-grid">

          <div class="hero-copy">
            <div class="category">
              {post.data.category}
            </div>

            <h1>{post.data.title}</h1>

            <p class="description">
              {post.data.description}
            </p>

            <div class="meta-line">
              <span>{publishedDate}</span>
              <span>•</span>
              <span>INVESThOuR</span>
            </div>
          </div>

          {
            post.data.thumbnail && (
              <figure class="hero-image">
                <img
                  src={post.data.thumbnail}
                  alt={post.data.title}
                  loading="eager"
                />
              </figure>
            )
          }

        </div>
      </div>
    </section>

    {
      post.data.youtubeId && (
        <section class="video-section">
          <div class="container">
            <div class="video-card">
              <div class="video-heading">
                <div>
                  <p class="eyebrow">WATCH FIRST</p>

                  <h2>
                    Prefer watching this breakdown?
                  </h2>

                  <p>
                    See the visual explanation before
                    diving into the details.
                  </p>
                </div>

                <span class="video-label">
                  YOUTUBE
                </span>
              </div>

              <div class="video-wrapper">
                <iframe
                  src={`https://www.youtube.com/embed/${post.data.youtubeId}`}
                  title={post.data.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="reading-section">
      <div class="container reading-grid">

        <aside class="sidebar">

          <div class="sidebar-card">
            <p class="eyebrow">ARTICLE</p>

            <a href="#article">Read</a>

            {
              post.data.youtubeId && (
                <a href="#video">Video</a>
              )
            }

            <a href="/blog">All articles</a>
          </div>

          <div class="sidebar-tip">
            <span>₹</span>
            <p>
              Understand the decision, not just
              the number.
            </p>
          </div>

        </aside>

        <article class="article-content" id="article">

          <div class="article-intro">
            <span class="intro-line"></span>

            <p>
              This article explains the topic in plain language,
              then goes deeper into the details that actually matter.
            </p>
          </div>

          <Content />

          <div class="key-takeaway">
            <div class="takeaway-label">
              KEY TAKEAWAY
            </div>

            <h3>
              Good financial decisions come from
              understanding the trade-offs.
            </h3>

            <p>
              Don't focus on one number in isolation.
              Look at the full picture before making a decision.
            </p>
          </div>

          <div class="disclaimer">
            <strong>Educational content</strong>

            <p>
              INVESThOuR content is for general educational and
              informational purposes and is not financial,
              investment, tax or legal advice.
            </p>
          </div>

          {
            post.data.youtubeId && (
              <div class="youtube-cta">
                <div>
                  <p class="eyebrow">CONTINUE WATCHING</p>

                  <h2>
                    Take the full breakdown to YouTube.
                  </h2>

                  <p>
                    More practical explanations about money,
                    investing and financial decisions.
                  </p>
                </div>

                <a
                  href={`https://www.youtube.com/watch?v=${post.data.youtubeId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Watch on YouTube →
                </a>
              </div>
            )
          }

        </article>

      </div>
    </section>

  </main>
</Layout>

<style>
  .article-page {
    color: var(--text);
  }

  .container {
    width: min(var(--container), calc(100% - 40px));
    margin-inline: auto;
  }

  .article-hero {
    padding: 42px 0 75px;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 55px;

    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 65px;
    align-items: center;
  }

  .category {
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 14px 0 22px;

    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 6vw, 6.3rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .description {
    max-width: 720px;
    margin: 0;

    color: var(--text-secondary);
    font-size: 1.13rem;
    line-height: 1.8;
  }

  .meta-line {
    display: flex;
    gap: 10px;
    margin-top: 25px;

    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    text-transform: uppercase;
  }

  .hero-image {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-soft);
    border: 1px solid var(--border);
  }

  .hero-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .video-section {
    padding: 52px 0 15px;
  }

  .video-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .video-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 25px;
  }

  .eyebrow {
    margin: 0;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .video-heading h2 {
    margin: 9px 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .video-heading p:not(.eyebrow) {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .video-label {
    flex: 0 0 auto;

    padding: 7px 9px;
    border-radius: 8px;

    background: #ff0000;
    color: white;

    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .video-wrapper {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 15px;
    background: #000;
  }

  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .reading-section {
    padding: 70px 0 110px;
  }

  .reading-grid {
    display: grid;
    grid-template-columns: 190px minmax(0, 770px);
    justify-content: center;
    gap: 65px;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 115px;
  }

  .sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 13px;

    padding-left: 17px;
    border-left: 2px solid var(--border);
  }

  .sidebar-card a {
    color: var(--text-secondary);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }

  .sidebar-card a:hover {
    color: var(--brand);
  }

  .sidebar-tip {
    margin-top: 30px;
    padding: 18px;

    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--text);
  }

  .sidebar-tip span {
    display: grid;
    place-items: center;

    width: 30px;
    height: 30px;
    margin-bottom: 12px;

    border-radius: 50%;

    background: var(--brand);
    color: #07100d;

    font-family: var(--font-display);
    font-weight: 700;
  }

  .sidebar-tip p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.83rem;
    line-height: 1.55;
  }

  .article-content {
    min-width: 0;
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.9;
  }

  .article-intro {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
  }

  .intro-line {
    width: 4px;
    flex: 0 0 4px;
    border-radius: 999px;
    background: var(--brand);
  }

  .article-intro p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .article-content :global(h2) {
    margin: 62px 0 16px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .article-content :global(h3) {
    margin: 38px 0 12px;
    color: var(--text);
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .article-content :global(p) {
    margin: 0 0 23px;
    color: var(--text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 26px;
    padding-left: 25px;
    color: var(--text-secondary);
  }

  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-content :global(strong) {
    color: var(--text);
  }

  .article-content :global(a) {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .article-content :global(blockquote) {
    margin: 35px 0;
    padding: 25px 27px;
    border-left: 4px solid var(--brand);
    border-radius: 0 13px 13px 0;
    background: var(--surface-soft);
  }

  .article-content :global(img) {
    display: block;
    width: 100%;
    margin: 30px 0;
    border-radius: 15px;
  }

  .key-takeaway {
    margin: 55px 0;
    padding: 30px;
    border: 1px solid var(--brand);
    border-radius: var(--radius-md);
    background: var(--brand-soft);
  }

  .takeaway-label {
    margin-bottom: 12px;
    color: var(--brand-dark);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.07em;
  }

  .key-takeaway h3 {
    margin: 0 0 12px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .key-takeaway p {
    margin: 0;
    color: var(--text-secondary);
  }

  .disclaimer {
    margin-top: 50px;
    padding: 20px 22px;

    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-soft);
  }

  .disclaimer strong {
    color: var(--text);
    font-size: 0.87rem;
  }

  .disclaimer p {
    margin: 7px 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .youtube-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    margin-top: 52px;
    padding: 30px;

    border-radius: var(--radius-md);
    background: #121916;
    color: white;
  }

  html[data-theme="dark"] .youtube-cta {
    background: #161c19;
  }

  .youtube-cta h2 {
    margin: 8px 0 10px;
    color: white;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }

  .youtube-cta p:not(.eyebrow) {
    margin: 0;
    color: #b6c0bb;
    line-height: 1.7;
  }

  .youtube-cta a {
    flex: 0 0 auto;

    padding: 13px 17px;
    border-radius: 10px;

    background: white;
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 950px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-image {
      max-width: 780px;
    }

    .reading-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .article-hero {
      padding: 30px 0 50px;
    }

    .breadcrumbs {
      margin-bottom: 35px;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    .video-card {
      padding: 20px;
    }

    .video-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .reading-section {
      padding-top: 50px;
    }

    .article-content {
      font-size: 1rem;
    }

    .youtube-cta {
      align-items: flex-start;
      flex-direction: column;
    }

    .youtube-cta a {
      width: 100%;
      text-align: center;
    }
  }
</style>