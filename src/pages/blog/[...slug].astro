---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedDate = post.data.date.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title={`${post.data.title} | INVESThOuR`}
  description={post.data.description}
>
  <article class="article-page">
    <div class="container">

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog">Blog</a>
        <span>/</span>
        <span>{post.data.category}</span>
      </nav>

      <header class="article-header">
        <div class="category">{post.data.category}</div>

        <h1>{post.data.title}</h1>

        <p class="description">
          {post.data.description}
        </p>

        <div class="meta">
          <span>Published {publishedDate}</span>
          <span>•</span>
          <span>INVESThOuR</span>
        </div>
      </header>

      {
        post.data.thumbnail && (
          <figure class="featured-image">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              loading="eager"
            />
          </figure>
        )
      }

      {
        post.data.youtubeId && (
          <section class="watch-card" id="watch-video">
            <div>
              <p class="eyebrow">WATCH THE VIDEO</p>
              <h2>Prefer watching this breakdown?</h2>
              <p>
                Watch the complete INVESThOuR video for the visual
                explanation and examples.
              </p>
            </div>

            <div class="video-wrapper">
              <iframe
                src={`https://www.youtube.com/embed/${post.data.youtubeId}`}
                title={post.data.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        )
      }

      <div class="article-layout">

        <aside class="article-sidebar">
          <div class="sidebar-card">
            <p class="eyebrow">ON THIS PAGE</p>

            <a href="#article">Article</a>

            {
              post.data.youtubeId && (
                <a href="#watch-video">Video</a>
              )
            }

            <a href="/blog">More articles</a>
          </div>
        </aside>

        <div class="article-content" id="article">
          <Content />

          <div class="disclaimer">
            <strong>Disclaimer</strong>

            <p>
              This content is for educational and informational purposes
              only. It should not be considered financial, investment,
              tax or legal advice. Do your own research and consider
              your individual circumstances before making financial
              decisions.
            </p>
          </div>

          {
            post.data.youtubeId && (
              <div class="youtube-cta">
                <div>
                  <p class="eyebrow">WATCH ON YOUTUBE</p>
                  <h2>Continue the conversation on YouTube.</h2>
                  <p>
                    Watch more practical breakdowns from INVESThOuR.
                  </p>
                </div>

                <a
                  href={`https://www.youtube.com/watch?v=${post.data.youtubeId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Watch on YouTube →
                </a>
              </div>
            )
          }
        </div>

      </div>

    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding: 40px 0 100px;
  }

  .breadcrumbs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 50px;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .breadcrumbs a {
    color: #4b5563;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--text);
  }

  .article-header {
    max-width: 900px;
    margin-bottom: 45px;
  }

  .category {
    margin-bottom: 14px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .description {
    max-width: 780px;
    margin: 28px 0 0;
    color: var(--text-secondary);
    font-size: 1.2rem;
    line-height: 1.75;
  }

  .meta {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .featured-image {
    max-width: 1100px;
    margin: 0 0 60px;
  }

  .featured-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    border-radius: 20px;
  }

  .watch-card {
    max-width: 1100px;
    margin-bottom: 70px;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-soft);
  }

  .eyebrow {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .watch-card h2 {
    margin: 8px 0;
    font-size: 1.8rem;
    letter-spacing: -0.03em;
  }

  .watch-card p:not(.eyebrow) {
    margin: 0 0 25px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .video-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #111827;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    gap: 60px;
    align-items: start;
  }

  .article-sidebar {
    position: sticky;
    top: 100px;
  }

  .sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 18px;
    border-left: 2px solid #e5e7eb;
  }

  .sidebar-card a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .sidebar-card a:hover {
    color: var(--text);
  }

  .article-content {
    min-width: 0;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .article-content :global(h2) {
    margin: 55px 0 15px;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .article-content :global(h3) {
    margin: 35px 0 12px;
    font-size: 1.4rem;
  }

  .article-content :global(p) {
    margin: 0 0 22px;
    color: var(--text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 25px;
    padding-left: 25px;
    color: var(--text-secondary);
  }

  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-content :global(strong) {
    color: var(--text);
  }

  .article-content :global(a) {
    color: var(--text);
    font-weight: 600;
  }

  .disclaimer {
    margin-top: 55px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-soft);
  }

  .disclaimer strong {
    font-size: 0.9rem;
  }

  .disclaimer p {
    margin: 8px 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .youtube-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 55px;
    padding: 30px;
    border-radius: 16px;
    background: #111827;
    color: white;
  }

  .youtube-cta h2 {
    margin: 8px 0;
    font-size: 1.6rem;
  }

  .youtube-cta p:not(.eyebrow) {
    margin: 0;
    color: var(--text-muted);
  }

  .youtube-cta a {
    flex-shrink: 0;
    padding: 12px 18px;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .article-sidebar {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .article-page {
      padding-top: 30px;
    }

    .article-header {
      margin-bottom: 35px;
    }

    .featured-image img {
      border-radius: 14px;
    }

    .watch-card {
      padding: 20px;
      border-radius: 16px;
    }

    .youtube-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .youtube-cta a {
      width: 100%;
      text-align: center;
    }

    .meta {
      flex-wrap: wrap;
    }
  }
</style>