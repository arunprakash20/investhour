---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const sortedPosts = [...posts].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = [
  "All",
  "Personal Finance",
  "Investing",
  "Tools",
  "Money Mistakes",
  "Stocks",
  "Mutual Funds",
  "IPOs",
];
---

<Layout
  title="Articles | INVESThOuR"
  description="Deep, practical articles about personal finance, investing and smarter money decisions."
>
  <main class="articles-page">

    <section class="articles-hero">
      <div class="container">
        <p class="eyebrow">INVESThOuR ARTICLES</p>

        <h1>
          Finance,
          <span>without the noise.</span>
        </h1>

        <p class="hero-copy">
          Go deeper than the headline. Understand the numbers,
          trade-offs and decisions behind your money.
        </p>
      </div>
    </section>

    <section class="category-bar">
      <div class="container">
        <div class="filters" aria-label="Article categories">
          {
            categories.map((category) => (
              <button
                type="button"
                class:list={[
                  "filter",
                  category === "All" && "active",
                ]}
                data-filter={category}
              >
                {category}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {
      featuredPost && (
        <section class="featured-section">
          <div class="container">

            <p class="section-label">FEATURED</p>

            <a
              href={`/blog/${featuredPost.id}`}
              class="featured-article"
              data-category={featuredPost.data.category}
            >
              {
                featuredPost.data.thumbnail && (
                  <div class="featured-image">
                    <img
                      src={featuredPost.data.thumbnail}
                      alt={featuredPost.data.title}
                    />

                    <span class="featured-tag">
                      FEATURED
                    </span>
                  </div>
                )
              }

              <div class="featured-copy">
                <p class="meta">
                  {featuredPost.data.category}
                  {" · "}
                  {featuredPost.data.date.toLocaleDateString(
                    "en-IN",
                    {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    }
                  )}
                </p>

                <h2>
                  {featuredPost.data.title}
                </h2>

                <p class="description">
                  {featuredPost.data.description}
                </p>

                <span class="read-link">
                  Read article →
                </span>
              </div>
            </a>

          </div>
        </section>
      )
    }

    <section class="latest-section">
      <div class="container">

        <div class="section-heading">
          <div>
            <p class="eyebrow">LATEST</p>
            <h2>Keep learning.</h2>
          </div>

          <span class="count">
            {sortedPosts.length} articles
          </span>
        </div>

        <div class="article-list">
          {
            remainingPosts.map((post, index) => (
              <a
                href={`/blog/${post.id}`}
                class="article-row"
                data-category={post.data.category}
              >
                <span class="number">
                  {String(index + 2).padStart(2, "0")}
                </span>

                {
                  post.data.thumbnail && (
                    <div class="thumbnail">
                      <img
                        src={post.data.thumbnail}
                        alt={post.data.title}
                        loading="lazy"
                      />
                    </div>
                  )
                }

                <div class="article-info">
                  <p class="meta">
                    {post.data.category}
                    {" · "}
                    {post.data.date.toLocaleDateString(
                      "en-IN",
                      {
                        day: "numeric",
                        month: "short",
                        year: "numeric",
                      }
                    )}
                  </p>

                  <h3>{post.data.title}</h3>

                  <p>{post.data.description}</p>
                </div>

                <span class="arrow">→</span>
              </a>
            ))
          }
        </div>

        {
          sortedPosts.length > 4 && (
            <button
              type="button"
              class="load-more"
              id="load-more"
            >
              Load more articles
            </button>
          )
        }

      </div>
    </section>

    <section class="articles-cta">
      <div class="container">
        <div class="cta-inner">
          <div>
            <p class="eyebrow">STILL CONFUSED?</p>

            <h2>
              Start with the
              <span>videos.</span>
            </h2>

            <p>
              Some money concepts are easier to understand
              when you see them explained visually.
            </p>
          </div>

          <a href="/videos" class="cta-button">
            Explore videos →
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  function initialiseArticlePage() {
    const filters =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-filter]"
      );

    const rows =
      document.querySelectorAll<HTMLElement>(
        ".article-row[data-category], .featured-article[data-category]"
      );

    filters.forEach((filter) => {
      if (filter.dataset.bound === "true") return;

      filter.dataset.bound = "true";

      filter.addEventListener("click", () => {
        const category =
          filter.dataset.filter ?? "All";

        filters.forEach((item) => {
          item.classList.toggle(
            "active",
            item === filter
          );
        });

        rows.forEach((row) => {
          const rowCategory =
            row.dataset.category ?? "";

          const visible =
            category === "All" ||
            rowCategory === category;

          row.classList.toggle(
            "hidden",
            !visible
          );
        });
      });
    });

    const loadMore =
      document.querySelector<HTMLButtonElement>(
        "#load-more"
      );

    if (loadMore && loadMore.dataset.bound !== "true") {
      loadMore.dataset.bound = "true";

      const allRows = Array.from(
        document.querySelectorAll<HTMLElement>(
          ".article-row"
        )
      );

      const initialVisible = 5;

      allRows.forEach((row, index) => {
        if (index >= initialVisible) {
          row.classList.add("pagination-hidden");
        }
      });

      loadMore.addEventListener("click", () => {
        allRows.forEach((row) => {
          row.classList.remove("pagination-hidden");
        });

        loadMore.remove();
      });
    }
  }

  document.addEventListener(
    "astro:page-load",
    initialiseArticlePage
  );

  initialiseArticlePage();
</script>

<style>
  .articles-hero {
    padding: 92px 0 70px;
    border-bottom: 1px solid var(--border);
  }

  .articles-hero h1 {
    max-width: 900px;
    margin: 15px 0 20px;

    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .articles-hero h1 span {
    color: var(--brand);
  }

  .hero-copy {
    max-width: 720px;
    margin: 0;

    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .eyebrow,
  .meta,
  .section-label,
  .count {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: var(--brand);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .category-bar {
    position: sticky;
    top: 82px;
    z-index: 20;

    padding: 16px 0;
    border-bottom: 1px solid var(--border);

    background: color-mix(
      in srgb,
      var(--bg) 92%,
      transparent
    );

    backdrop-filter: blur(16px);
  }

  .filters {
    display: flex;
    gap: 9px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: 0 0 auto;

    padding: 9px 14px;

    border: 1px solid var(--border);
    border-radius: 999px;

    background: var(--surface);
    color: var(--text-secondary);

    cursor: pointer;
    font-size: 0.84rem;

    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .filter:hover {
    transform: translateY(-1px);
    border-color: var(--brand);
    color: var(--text);
  }

  .filter.active {
    border-color: var(--brand);
    background: var(--brand);
    color: #07100d;
  }

  .featured-section {
    padding: 65px 0 45px;
  }

  .section-label {
    margin-bottom: 14px;
  }

  .featured-article {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;

    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    background: var(--surface);

    text-decoration: none;

    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .featured-article:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .featured-image {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    background: var(--surface-soft);
  }

  .featured-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .featured-article:hover .featured-image img {
    transform: scale(1.035);
  }

  .featured-tag {
    position: absolute;
    top: 20px;
    left: 20px;

    padding: 7px 10px;
    border-radius: 8px;

    background: var(--surface);
    color: var(--text);

    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 600;
  }

  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 46px;
  }

  .meta {
    margin: 0 0 10px;

    color: var(--brand);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .featured-copy h2 {
    margin: 0;

    color: var(--text);
    font-family: var(--font-display);

    font-size: clamp(2.3rem, 4vw, 4.1rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .description {
    margin: 18px 0 25px;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .read-link {
    width: fit-content;
    color: var(--text);
    font-weight: 700;
  }

  .latest-section {
    padding: 70px 0 105px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 27px;
  }

  .section-heading h2 {
    margin: 9px 0 0;

    color: var(--text);
    font-family: var(--font-display);

    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .count {
    color: var(--text-muted);
    font-size: 0.66rem;
  }

  .article-list {
    border-top: 1px solid var(--border);
  }

  .article-row {
    display: grid;
    grid-template-columns: 40px 220px 1fr 24px;

    gap: 22px;
    align-items: center;

    padding: 23px 0;

    border-bottom: 1px solid var(--border);

    text-decoration: none;

    transition:
      padding 180ms ease,
      background 180ms ease;
  }

  .article-row:hover {
    padding-inline: 10px;
    background: var(--surface);
  }

  .article-row.hidden {
    display: none;
  }

  .article-row.pagination-hidden {
    display: none;
  }

  .number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .thumbnail {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 11px;
    background: var(--surface-soft);
  }

  .thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-info h3 {
    margin: 0 0 8px;

    color: var(--text);
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .article-info > p:not(.meta) {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .arrow {
    color: var(--text-muted);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .article-row:hover .arrow {
    transform: translateX(4px);
    color: var(--brand);
  }

  .load-more {
    display: block;
    margin: 35px auto 0;

    padding: 12px 17px;

    border: 1px solid var(--border);
    border-radius: 10px;

    background: var(--surface);
    color: var(--text);

    cursor: pointer;
    font-weight: 700;
  }

  .load-more:hover {
    border-color: var(--brand);
    background: var(--surface-soft);
  }

  .articles-cta {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 40px;
    padding: 85px 0;
  }

  .cta-inner h2 {
    max-width: 700px;
    margin: 10px 0 12px;

    color: var(--text);
    font-family: var(--font-display);

    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .cta-inner h2 span {
    color: var(--brand);
  }

  .cta-inner p:not(.eyebrow) {
    max-width: 560px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .cta-button {
    flex: 0 0 auto;

    padding: 14px 18px;
    border-radius: 12px;

    background: var(--brand);
    color: #07100d;

    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .featured-article {
      grid-template-columns: 1fr;
    }

    .featured-image {
      min-height: 320px;
    }

    .article-row {
      grid-template-columns: 32px 170px 1fr 20px;
      gap: 16px;
    }
  }

  @media (max-width: 650px) {
    .articles-hero {
      padding: 55px 0 48px;
    }

    .articles-hero h1 {
      font-size: clamp(3.2rem, 15vw, 5rem);
    }

    .featured-copy {
      padding: 27px;
    }

    .article-row {
      grid-template-columns: 32px 1fr 18px;
    }

    .article-row .thumbnail {
      grid-column: 2;
      grid-row: 1;
    }

    .article-row .article-info {
      grid-column: 2 / -1;
      grid-row: 2;
    }

    .article-row .arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
      text-align: center;
    }
  }
</style>