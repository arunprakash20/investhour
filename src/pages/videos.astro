---
import Layout from "../layouts/Layout.astro";
import { videos } from "../data/videos.js";
import VideoCard from "../components/VideoCard.astro";
---

<Layout
  title="Videos | INVESThOuR"
  description="Watch INVESThOuR videos about personal finance, investing, mutual funds and smarter money decisions."
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">INVESThOuR VIDEOS</p>
      <h1>Money. Investing. Explained.</h1>
      <p>
        Practical videos about personal finance, investing and financial
        decisions — without unnecessary jargon.
      </p>
    </div>
  </section>

  <section class="videos-section">
    <div class="container">
      <div class="filters">
        <button class="active">All</button>
        <button>Personal Finance</button>
        <button>Investing</button>
        <button>Mutual Funds</button>
        <button>IPO</button>
      </div>

      <div class="video-grid">
        {videos.map((video) => (
          <VideoCard {...video} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 80px 0 60px;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
  }

  .page-header h1 {
    max-width: 800px;
    margin: 12px 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .page-header p:last-child {
    max-width: 650px;
    margin: 0;
    color: #6b7280;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #6b7280;
  }

  .videos-section {
    padding: 60px 0 100px;
  }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .filters button {
    border: 1px solid #d1d5db;
    border-radius: 999px;
    padding: 9px 16px;
    background: white;
    color: #374151;
    cursor: pointer;
    font: inherit;
  }

  .filters button.active {
    background: #111827;
    color: white;
    border-color: #111827;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .video-grid {
      grid-template-columns: 1fr;
    }

    .page-header {
      padding: 60px 0 45px;
    }
  }
</style>