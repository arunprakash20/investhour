---
import Layout from "../layouts/Layout.astro";
import { videos } from "../data/videos.js";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const latestVideos = [...videos]
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 3);

const latestPosts = [...posts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredVideo = latestVideos[0];
const secondaryVideos = latestVideos.slice(1);

const featuredArticle = latestPosts[0];
const secondaryArticles = latestPosts.slice(1);
---

<Layout
  title="INVESThOuR | Finance Finally Feels Easy."
  description="INVESThOuR makes personal finance, investing and money decisions easier to understand through videos, articles and practical tools."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-copy">
        <p class="eyebrow">
          PERSONAL FINANCE · INVESTING · TOOLS
        </p>

        <h1>
          Finance finally
          <span>feels easy.</span>
        </h1>

        <p class="hero-description">
          Understand money. Make better decisions.
          Build your own financial confidence.
        </p>

        <div class="hero-actions">
          <a href="/videos" class="button-primary">
            Explore videos
            <span>→</span>
          </a>

          <a href="/blog" class="button-secondary">
            Read articles
          </a>
        </div>

        <div class="hero-note">
          <span class="note-mark">✦</span>
          No preaching. No unnecessary jargon.
          Just finance you can actually understand.
        </div>
      </div>

      {
        featuredVideo && (
          <a
            href={`/videos/${featuredVideo.slug}`}
            class="featured-video"
          >
            <div class="featured-video-image">
              <img
                src={featuredVideo.thumbnail}
                alt={featuredVideo.title}
                loading="eager"
              />

              <span class="play-button" aria-hidden="true">
                ▶
              </span>

              <span class="featured-label">
                FEATURED VIDEO
              </span>
            </div>

            <div class="featured-video-content">
              <p class="meta">
                {featuredVideo.category}
              </p>

              <h2>{featuredVideo.title}</h2>

              <p>
                {featuredVideo.description}
              </p>

              <span class="watch-link">
                Watch breakdown →
              </span>
            </div>
          </a>
        )
      }

    </div>
  </section>

  <!-- TOPIC STRIP -->
  <section class="topic-strip">
    <div class="container topic-inner">
      <span>Explore by topic</span>

      <div class="topics">
        <a href="/blog">Personal Finance</a>
        <a href="/blog">Investing</a>
        <a href="/blog">Money Mistakes</a>
        <a href="/blog">Stocks</a>
        <a href="/blog">Mutual Funds</a>
        <a href="/blog">IPOs</a>
      </div>
    </div>
  </section>

  <!-- LATEST VIDEOS -->
  <section class="section">
    <div class="container">

      <div class="section-heading">
        <div>
          <p class="eyebrow">WATCH</p>
          <h2>Money, explained visually.</h2>
        </div>

        <a href="/videos" class="section-link">
          View all videos →
        </a>
      </div>

      <div class="video-showcase">

        {
          secondaryVideos.map((video, index) => (
            <a
              href={`/videos/${video.slug}`}
              class:list={[
                "video-story",
                index === 0 && "video-story-feature",
              ]}
            >
              <div class="video-story-image">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  loading="lazy"
                />

                <span class="mini-play">
                  ▶
                </span>
              </div>

              <div class="story-content">
                <p class="meta">
                  {video.category}
                </p>

                <h3>{video.title}</h3>

                <span class="story-arrow">
                  Watch →
                </span>
              </div>
            </a>
          ))
        }

        <div class="video-quote">
          <span class="quote-mark">“</span>

          <p>
            You don't need to be a finance expert
            to start making better money decisions.
          </p>

          <span class="quote-author">
            — INVESThOuR
          </span>
        </div>

      </div>

    </div>
  </section>

  <!-- ARTICLES -->
  <section class="section section-alt">
    <div class="container">

      <div class="section-heading">
        <div>
          <p class="eyebrow">READ</p>
          <h2>Go deeper than the video.</h2>
        </div>

        <a href="/blog" class="section-link">
          View all articles →
        </a>
      </div>

      <div class="article-layout">

        {
          featuredArticle && (
            <a
              href={`/blog/${featuredArticle.id}`}
              class="featured-article"
            >
              <div class="article-number">
                01
              </div>

              <div>
                <p class="meta">
                  {featuredArticle.data.category}
                </p>

                <h3>
                  {featuredArticle.data.title}
                </h3>

                <p class="article-excerpt">
                  {featuredArticle.data.description}
                </p>

                <span class="read-link">
                  Read article →
                </span>
              </div>
            </a>
          )
        }

        <div class="article-list">
          {
            secondaryArticles.map((post, index) => (
              <a
                href={`/blog/${post.id}`}
                class="article-row"
              >
                <span class="article-row-number">
                  {String(index + 2).padStart(2, "0")}
                </span>

                <div>
                  <p class="meta">
                    {post.data.category}
                  </p>

                  <h3>{post.data.title}</h3>

                  <p>
                    {post.data.description}
                  </p>
                </div>

                <span class="article-row-arrow">
                  →
                </span>
              </a>
            ))
          }
        </div>

      </div>

    </div>
  </section>

  <!-- TOOLS -->
  <section class="section tools-section">
    <div class="container">

      <div class="tools-header">
        <div>
          <p class="eyebrow">TOOLS</p>

          <h2>
            When understanding isn't enough,
            <span>calculate it.</span>
          </h2>
        </div>

        <p>
          Practical tools are coming to INVESThOuR —
          built to help you make decisions, not just
          watch explanations.
        </p>
      </div>

      <div class="tools-grid">

        <div class="tool-card tool-card-featured">
          <span class="tool-number">01</span>

          <div>
            <p class="tool-status">
              COMING SOON
            </p>

            <h3>
              Rent vs Buy Calculator
            </h3>

            <p>
              See how rent, EMI, opportunity cost,
              maintenance and investment returns
              change the decision.
            </p>
          </div>
        </div>

        <div class="tool-card">
          <span class="tool-number">02</span>

          <div>
            <p class="tool-status">
              COMING SOON
            </p>

            <h3>
              SIP Calculator
            </h3>

            <p>
              Understand how your investments could
              grow over time.
            </p>
          </div>
        </div>

        <div class="tool-card">
          <span class="tool-number">03</span>

          <div>
            <p class="tool-status">
              COMING SOON
            </p>

            <h3>
              More useful tools
            </h3>

            <p>
              Built around real financial decisions,
              not spreadsheet complexity.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- CREATOR MOMENT -->
  <section class="creator-section">
    <div class="container">

      <div class="creator-card">

        <div class="creator-copy">
          <p class="eyebrow">
            THE INVESThOuR APPROACH
          </p>

          <h2>
            You don't have to
            <span>know everything.</span>
          </h2>

          <p>
            You just need to understand the things
            that matter when you're making a financial
            decision.
          </p>

          <a href="/about" class="creator-link">
            Why INVESThOuR exists →
          </a>
        </div>

        <div class="creator-doodle" aria-hidden="true">
          <div class="coin coin-one">₹</div>
          <div class="coin coin-two">%</div>

          <div class="speech">
            "Wait... that's it?"
          </div>

          <div class="arrow doodle-arrow">
            ↗
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- YOUTUBE CTA -->
  <section class="final-cta">
    <div class="container">

      <div class="final-cta-inner">

        <div>
          <p class="eyebrow">
            WATCH INVESThOuR
          </p>

          <h2>
            Learn something useful
            <span>today.</span>
          </h2>
        </div>

        <a
          href="https://www.youtube.com/@INVESThOuR"
          target="_blank"
          rel="noopener noreferrer"
          class="youtube-cta"
        >
          <span class="youtube-play">▶</span>
          <span>Watch on YouTube</span>
          <span>↗</span>
        </a>

      </div>

    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 88px 0 70px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 70px;
    align-items: center;
  }

  .hero-copy {
    max-width: 690px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--brand);
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 18px 0 24px;
    font-family: var(--font-display);
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
    color: var(--brand);
  }

  .hero-description {
    max-width: 600px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 19px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .button-primary {
    background: var(--brand);
    color: #07100d;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .button-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .button-secondary {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .button-secondary:hover {
    background: var(--surface-soft);
  }

  .hero-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 520px;
    margin-top: 28px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .note-mark {
    flex: 0 0 auto;
    color: var(--brand);
  }

  .featured-video {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .featured-video:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 55px rgba(16, 24, 20, 0.12);
  }

  .featured-video-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface-soft);
  }

  .featured-video-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .featured-video:hover img {
    transform: scale(1.035);
  }

  .featured-label {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 9px;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--brand);
    color: #07100d;
    font-size: 1.1rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
  }

  .featured-video-content {
    padding: 28px;
  }

  .featured-video-content .meta,
  .meta {
    margin: 0 0 9px;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-video-content h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .featured-video-content > p:not(.meta) {
    margin: 14px 0 20px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .watch-link,
  .story-arrow,
  .read-link {
    color: var(--text);
    font-weight: 700;
  }

  .topic-strip {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .topic-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 72px;
  }

  .topic-inner > span {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .topics {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topics::-webkit-scrollbar {
    display: none;
  }

  .topics a {
    flex: 0 0 auto;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .topics a:hover {
    color: var(--brand);
  }

  .section {
    padding: 105px 0;
  }

  .section-alt {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 38px;
  }

  .section-heading h2 {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .section-link {
    flex: 0 0 auto;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--brand);
  }

  .video-showcase {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 22px;
  }

  .video-story,
  .video-quote {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg);
    text-decoration: none;
  }

  .video-story-feature {
    grid-row: span 2;
  }

  .video-story-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-soft);
  }

  .video-story-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .video-story:hover .video-story-image img {
    transform: scale(1.04);
  }

  .mini-play {
    position: absolute;
    right: 15px;
    bottom: 15px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
  }

  .story-content {
    padding: 22px;
  }

  .story-content h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.65rem;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .story-arrow {
    display: inline-block;
    margin-top: 18px;
  }

  .video-quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px;
    background: var(--brand);
    color: #07100d;
  }

  .quote-mark {
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 0.7;
  }

  .video-quote p {
    margin: 30px 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .quote-author {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
  }

  .featured-article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    padding: 34px;
    border-radius: var(--radius-lg);
    background: var(--bg);
    text-decoration: none;
  }

  .article-number {
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .featured-article h3 {
    margin: 4px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.2vw, 3.4rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .article-excerpt,
  .article-row p:not(.meta) {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .read-link {
    display: inline-block;
    margin-top: 22px;
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }

  .article-row {
    display: grid;
    grid-template-columns: 38px 1fr 25px;
    gap: 18px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .article-row:first-child {
    padding-top: 0;
  }

  .article-row-number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .article-row h3 {
    margin: 0 0 9px;
    font-size: 1.28rem;
    line-height: 1.15;
  }

  .article-row-arrow {
    color: var(--text-muted);
    font-size: 1.1rem;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .article-row:hover .article-row-arrow {
    transform: translateX(4px);
    color: var(--brand);
  }

  .tools-section {
    background: var(--bg);
  }

  .tools-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 40px;
  }

  .tools-header h2 {
    max-width: 760px;
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .tools-header h2 span {
    color: var(--brand);
  }

  .tools-header > p {
    max-width: 360px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
    gap: 18px;
  }

  .tool-card {
    min-height: 250px;
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .tool-card-featured {
    background: var(--surface-soft);
  }

  .tool-number {
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .tool-status {
    margin: 0 0 8px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .tool-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
  }

  .tool-card p:last-child {
    margin: 12px 0 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .creator-section {
    padding: 0 0 105px;
    background: var(--bg);
  }

  .creator-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    min-height: 400px;
    border-radius: var(--radius-lg);
    background: #121916;
    color: #f4f5f1;
  }

  html[data-theme="dark"] .creator-card {
    background: #161c19;
  }

  .creator-copy {
    padding: 60px;
    align-self: center;
  }

  .creator-copy h2 {
    max-width: 680px;
    margin: 12px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .creator-copy h2 span {
    color: var(--brand);
  }

  .creator-copy > p:not(.eyebrow) {
    max-width: 550px;
    margin: 0;
    color: #b4beb9;
    line-height: 1.75;
  }

  .creator-link {
    display: inline-block;
    margin-top: 24px;
    color: #f4f5f1;
    font-weight: 700;
    text-decoration: none;
  }

  .creator-doodle {
    position: relative;
    min-height: 400px;
  }

  .coin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border: 3px solid var(--brand);
    border-radius: 50%;
    color: var(--brand);
