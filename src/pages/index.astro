---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import VideoCard from "../components/VideoCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { videos } from "../data/videos.js";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const latestVideos = [...videos]
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 3);

const latestPosts = [...posts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title="INVESThOuR | Money. Investing. Smarter Decisions."
  description="INVESThOuR explains personal finance, investing, mutual funds, IPOs and smarter money decisions."
>
  <Hero />

  <!-- Latest Videos -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST VIDEOS</p>
          <h2>Watch the latest from INVESThOuR</h2>
        </div>

        <a href="/videos">View all →</a>
      </div>

      <div class="video-grid">
        {latestVideos.map((video) => (
          <VideoCard {...video} />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section muted">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FROM THE BLOG</p>
          <h2>Learn something new</h2>
        </div>

        <a href="/blog">View all →</a>
      </div>

      <div class="article-grid">
        {latestPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date.toLocaleDateString("en-IN", {
              day: "numeric",
              month: "short",
              year: "numeric",
            })}
            category={post.data.category}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- YouTube CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta">
        <p class="eyebrow">INVESThOuR ON YOUTUBE</p>

        <h2>
          Learn about money without the complicated jargon.
        </h2>

        <p>
          Watch practical breakdowns of personal finance, investing,
          mutual funds, IPOs and more.
        </p>

        <a
          href="https://www.youtube.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button"
        >
          Subscribe on YouTube →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 80px 0;
  }

  .muted {
    background: #f8fafc;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
  }

  .section-heading h2 {
    margin: 8px 0 0;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .section-heading a {
    color: #111827;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #6b7280;
  }

  .video-grid,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cta-section {
    padding: 80px 0;
  }

  .cta {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px 40px;
    text-align: center;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    background: #f8fafc;
  }

  .cta h2 {
    margin: 12px 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .cta p:not(.eyebrow) {
    max-width: 600px;
    margin: 0 auto 28px;
    color: #6b7280;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 8px;
    background: #111827;
    color: white;
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .video-grid,
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .video-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .cta {
      padding: 40px 24px;
    }
  }
</style>